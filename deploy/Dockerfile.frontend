# Build context: raiz do repositório (knoll/)
# docker compose build usa: context: ..  dockerfile: deploy/Dockerfile.frontend

FROM node:20-alpine AS build
WORKDIR /app

COPY nova_versao/frontend/package.json nova_versao/frontend/package-lock.json* ./
RUN npm ci || npm install

COPY nova_versao/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
