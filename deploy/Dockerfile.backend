# Build context: raiz do repositório (knoll/)
# docker compose build usa: context: ..  dockerfile: deploy/Dockerfile.backend

FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY nova_versao/backend/package.json nova_versao/backend/package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

COPY nova_versao/backend/ ./

RUN mkdir -p uploads \
  && chown -R node:node /app

USER node

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/api/health',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
