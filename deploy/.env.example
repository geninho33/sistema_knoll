# Copie para deploy/.env e ajuste os valores antes do deploy
# cp deploy/.env.example deploy/.env

# --- Portas na VPS (host → container) ---
FRONTEND_HOST_PORT=8089
BACKEND_HOST_PORT=3300
MYSQL_HOST_PORT=3308

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_change_me
DB_NAME=knoll
DB_USER=knoll
DB_PASSWORD=knoll_change_me

# --- Backend ---
JWT_SECRET=troque_este_segredo_jwt_por_um_valor_longo
# Origens permitidas (opcional se CORS_STRICT não estiver ativo).
# Com o proxy Nginx na mesma porta do frontend, o CORS relaxado já libera o IP.
CORS_ORIGINS=http://localhost:8089,http://127.0.0.1:8089,http://69.6.215.35:8089
# CORS_STRICT=1
