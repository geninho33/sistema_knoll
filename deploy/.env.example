# Copie para deploy/.env e ajuste os valores antes do deploy
# cp deploy/.env.example deploy/.env

# --- Portas na VPS (host → container) ---
FRONTEND_HOST_PORT=8089
BACKEND_HOST_PORT=3300
MYSQL_HOST_PORT=3308

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_change_me
DB_NAME=knoll
DB_USER=knoll
DB_PASSWORD=knoll_change_me

# --- Backend ---
JWT_SECRET=troque_este_segredo_jwt_por_um_valor_longo
# Origens permitidas no CORS (separadas por vírgula). Inclua o URL público do frontend.
CORS_ORIGINS=http://localhost:8089,http://SEU_IP_OU_DOMINIO:8089
